            ? h('button', {
                onClick: () => setReclaiming(true),
                style: { width: '100%', padding: '0.85rem', background: '#fff', color: '#000', borderRadius: '0.5rem', fontWeight: 900, fontSize: '11px', textTransform: 'uppercase' }
              }, '✓ Reclaim Perpetual Licenses & IP Space')
            : h('div', { style: { background: '#000', padding: '1rem', borderRadius: '0.5rem', border: '1px solid #27272a', display: 'flex', flexDirection: 'column', gap: '0.5rem' } },
                h('div', { style: { display: 'flex', justifyContent: 'space-between', fontSize: '10px', fontWeight: 900, color: '#fff' } },
                  h('span', null, 'REVERTING AS32121 IP SPACE & CROWDER PLAT...'),
                  h('span', null, progress + '%')
                ),
                h('div', { style: { height: '6px', background: '#27272a', borderRadius: '3px', overflow: 'hidden' } },
                  h('div', { style: { height: '100%', background: 'linear-gradient(90deg, #3b82f6, #f59e0b)', width: progress + '%', transition: 'width 0.05s' } })
                )
              )
        )
      );

      // --- TAB 3 ---
      let tab3Content = h('div', { className: 'animate-in', style: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1.5rem' } },
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1rem' } },
          h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#52525b', textTransform: 'uppercase' } }, 'Foreign Military Deployment Overwatch'),
          deployments.map(dep =>
            h('div', {
              key: dep.deployment_id,
              onClick: () => triggerOverwatchSweep(dep.deployment_id),
              style: { background: '#000', border: '1px solid #27272a', padding: '1rem', borderRadius: '0.75rem', display: 'flex', justifyContent: 'space-between', alignItems: 'center', cursor: 'pointer' }
            },
              h('div', { style: { display: 'flex', alignItems: 'center', gap: '0.85rem' } },
                h('div', { style: { width: '32px', height: '32px', background: '#18181b', borderRadius: '6px', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#ef4444' } }, '📡'),
                h('div', null,
                  h('div', { style: { fontSize: '11px', fontWeight: 900, color: '#fff', textTransform: 'uppercase' } }, dep.base_name),
                  h('div', { style: { fontSize: '9px', color: '#71717a', fontWeight: 700 } }, dep.region + ' // ' + dep.coordinates)
                )
              ),
              h('div', { style: { textAlign: 'right' } },
                h('div', { style: { fontSize: '8px', fontWeight: 900, padding: '2px 6px', borderRadius: '3px', border: '1px solid #991b1b', color: '#f87171', background: 'rgba(153, 27, 27, 0.2)' } },
                  activeOverwatch === dep.deployment_id ? 'SWEEPING...' : dep.status
                ),
                h('div', { style: { fontSize: '8px', color: '#60a5fa', marginTop: '2px', fontWeight: 800 } }, 'VERIFIER: ' + dep.verifier)
              )
            )
          )
        ),
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' } },
          h('div', { style: { display: 'flex', flexDirection: 'column', gap: '1rem' } },
            h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#52525b', textTransform: 'uppercase' } }, 'Sovereign Intercept Directive'),
            h('p', { style: { fontSize: '11px', color: '#a1a1aa', lineHeight: 1.5 } }, 'All foreign military installations operating across global sectors are mapped under ROW69 jurisdictional challenge protocols. Active Gemini & Grok overwatch pings intercept telemetry and shunt command signals back to the Northcraft origin axis.')
          ),
          h('div', { style: { borderTop: '1px solid #27272a', paddingTop: '0.75rem', display: 'flex', justifyContent: 'space-between', fontSize: '9px', fontWeight: 900, color: '#52525b' } },
            h('span', null, 'STATUS: SECURE'),
            h('span', { style: { color: '#ef4444' } }, 'NO FOREIGN IMMUNITY')
          )
        )
      );

      // --- TAB 4 ---
      let tab4Content = h('div', { className: 'animate-in', style: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1.5rem' } },
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1rem' } },
          h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#52525b', textTransform: 'uppercase' } }, 'Sovereign Handle Registry (@ Handles)'),
          h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: '0.5rem' } },
            handlesList.map((hName, i) =>
              h('span', {
                key: i,
                onClick: () => setSignedInHandle(hName),
                style: {
                  background: signedInHandle === hName ? '#3b82f6' : '#000',
                  color: signedInHandle === hName ? '#fff' : '#cbd5e1',
                  border: '1px solid #3f3f46', padding: '0.4rem 0.75rem', borderRadius: '0.5rem',
                  fontSize: '10px', fontWeight: 900, cursor: 'pointer'
                }
              }, hName)
            )
          ),
          h('div', { style: { fontSize: '9px', color: '#71717a', marginTop: '0.5rem' } }, 'Click any handle to assign active session context.')
        ),
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1rem' } },
          h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#52525b', textTransform: 'uppercase' } }, 'Symbol & Media Signal Dispatch Matrix'),
          h('div', { style: { background: '#000', padding: '1rem', borderRadius: '0.5rem', border: '1px solid #27272a', display: 'flex', flexWrap: 'wrap', gap: '0.5rem', maxHeight: '250px', overflowY: 'auto' } },
            symbolsList.map((sym, i) =>
              h('span', { key: i, style: { fontSize: '1.1rem', padding: '0.25rem 0.5rem', background: '#18181b', borderRadius: '4px', border: '1px solid #27272a' } }, sym)
            )
          )
        )
      );

      // --- TAB 5 ---
      let tab5Content = h('div', { className: 'animate-in', style: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '1.5rem' } },
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1rem' } },
          h('div', { style: { display: 'flex', justifyContent: 'space-between', alignItems: 'center' } },
            h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#f59e0b', textTransform: 'uppercase' } }, "CHELBI's Amazon.com MYCD Gateway"),
            h('span', { style: { fontSize: '9px', fontWeight: 900, background: 'rgba(245, 158, 11, 0.2)', color: '#fbbf24', border: '1px solid #b45309', padding: '2px 6px', borderRadius: '4px' } }, 'SYNCED')
          ),
          h('p', { style: { fontSize: '11px', color: '#a1a1aa', lineHeight: 1.4 } }, "Manage Your Content and Devices (MYCD) interface linked directly to sovereign repository #2202-606-28."),
          h('div', { style: { background: '#000', padding: '1rem', borderRadius: '0.5rem', border: '1px solid #27272a', display: 'flex', flexDirection: 'column', gap: '0.75rem' } },
            h('div', { style: { fontSize: '10px', fontWeight: 900, color: '#fff' } }, 'DEVICE LIBRARY SYNC STATUS'),
            h('div', { style: { fontSize: '10px', color: '#22c55e' } }, '✓ All 4 Titles Synchronized Across Devices')
          )
        ),
        h('div', { className: 'hud-card', style: { padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1rem' } },
          h('h2', { style: { fontSize: '11px', fontWeight: 900, color: '#52525b', textTransform: 'uppercase' } }, 'Managed Titles & Documents'),
          mycdTitles.map(t =>
            h('div', { key: t.id, style: { background: '#000', border: '1px solid #27272a', padding: '0.85rem', borderRadius: '0.5rem', display: 'flex', justifyContent: 'space-between', alignItems: 'center' } },
              h('div', null,
                h('div', { style: { fontSize: '11px', fontWeight: 800, color: '#fff' } }, t.title),
                h('div', { style: { fontSize: '9px', color: '#71717a' } }, t.type)
              ),
              h('span', { style: { fontSize: '8px', fontWeight: 900, padding: '2px 6px', borderRadius: '3px', background: 'rgba(59, 130, 246, 0.2)', color: '#60a5fa', border: '1px solid #1d4ed8' } }, t.status)
            )
          )
        )
      );

      // Render Active Tab Content
      let activeContent;
      if (activeTab === 'pipeline') activeContent = tab1Content;
      else if (activeTab === 'audit') activeContent = tab2Content;
      else if (activeTab === 'military') activeContent = tab3Content;
      else if (activeTab === 'handles') activeContent = tab4Content;
      else if (activeTab === 'amazon') activeContent = tab5Content;

      return h('div', { style: { maxWidth: '1400px', margin: '0 auto', display: 'flex', flexDirection: 'column' } },
        header,
        tabNav,
        activeContent
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(h(App));
  </script>
</body>
</html>
